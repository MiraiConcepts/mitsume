# Dev-time same-origin proxy for WEB development (runs in Docker — nothing on the host).
#
# `expo start --web` serves on :8081, a different origin than the notes backend,
# so the browser would block its requests. This proxy puts Metro and both
# services behind ONE local origin, exactly like production:
#
#   http://localhost:8880/        → Metro dev server on the host (incl. HMR websocket)
#   http://localhost:8880/sync/*  → local mitsume-sync (notes doc sync, websocket)
#   http://localhost:8880/blobs/* → local mitsume-blobs (pasted-image bytes)
#
# Usage:
#   docker compose -f tooling/dev-proxy/compose.yml up -d      # start
#   docker compose -f tooling/dev-proxy/compose.yml down       # stop (removes container)
#
# No .env needed: both services are authless and built locally from server/.
# (The calendar's Radicale credentials used to live here; that moved to hitome.)
#
# app/.env needs nothing for web — /sync and /blobs/ resolve against the page origin.

:8880 {
	# Notes backend, same-origin like production (see docs/Deploy.md). The ws
	# client connects to bare /sync (no trailing slash), which handle_path
	# /sync/* would NOT match — hence the explicit two-form matcher.
	@sync path /sync /sync/*
	handle @sync {
		uri strip_prefix /sync
		reverse_proxy mitsume-sync:1234
	}
	handle_path /blobs/* {
		request_body {
			max_size 64MB
		}
		reverse_proxy mitsume-blobs:8080
	}

	# host.docker.internal = the Mac, from inside the container (see compose.yml).
	handle {
		reverse_proxy host.docker.internal:8081
	}
}
